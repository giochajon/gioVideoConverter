# Host paths bind-mounted into the container. LOG_DIR should live outside this
# project directory so the batch conversion log persists independently of the stack.
MOVIE_DIR=/path/to/movies
SERIES_DIR=/path/to/series
INTERACTIVE_DIR=/path/to/interactive
LOG_DIR=/path/to/giovideoconvert-logs

PORT=9095
TZ=America/Denver
DEFAULT_PRESET=Fast 720p30
